APP_NAME=FestaMate API
APP_ENV=development
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Required for API + agent. Use Supabase Direct or Session pooler (5432), not Transaction (6543).
# Apply docs/sql/001_agent_postgres.sql first. Set sslmode=require for remote Supabase.
DATABASE_URL=
DATABASE_REQUIRED=true
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=5

# Supabase Auth JWT verification.
# SUPABASE_KEY is the public Supabase client key and must not be used to verify JWTs.
SUPABASE_URL=https://<project-ref>.supabase.co
# Public Supabase client key for /auth/signup and /auth/login.
SUPABASE_KEY=
# Optional legacy HS256 secret. Leave empty when the project uses JWKS signing keys.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1

# PostgreSQL roles used while applying RLS to direct asyncpg connections.
DATABASE_ANON_ROLE=anon
DATABASE_AUTHENTICATED_ROLE=authenticated
# rules: explicit offline simulation. openai: real Responses API calls.
AGENT_MODEL_PROVIDER=rules
OPENAI_API_KEY=
OPENAI_MODEL=

# demo: fixed weather fixture. openmeteo: live hourly forecast for meeting coordinates/time.
AGENT_WEATHER_PROVIDER=openmeteo
# Korea Tourism Organization TourAPI key for the optional external sync worker.
TOUR_API_SERVICE_KEY=
# External sync worker tuning.
EXTERNAL_SYNC_POLL_INTERVAL=5
EXTERNAL_SYNC_HTTP_TIMEOUT=15
EXTERNAL_SYNC_LEASE_SECONDS=300
EXTERNAL_SYNC_MAX_ATTEMPTS=3
EXTERNAL_SYNC_RETRY_BASE_SECONDS=5

# Checkpoints, sessions and preferences use the same DATABASE_URL.
AGENT_DATABASE_POOL_MAX_SIZE=5
AGENT_DATABASE_TIMEOUT=10
AGENT_MAX_ITERATIONS=3
AGENT_TOOL_RETRIES=2

# Per planning cycle; approval always refreshes required sources on the server.
AGENT_MAX_TOOL_ROUNDS=8
AGENT_MAX_TOOL_CALLS=12

# Live weather monitoring interval; 0 disables automatic polling.
WEATHER_MONITOR_INTERVAL_SECONDS=300
